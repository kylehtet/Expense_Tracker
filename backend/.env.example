ANTHROPIC_API_KEY=

PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Defaults to a local SQLite file; point at a Postgres URL in production.
DATABASE_URL=sqlite:///./expense_tracker.db

# Path to the service account key JSON downloaded from Firebase Console ->
# Project Settings -> Service Accounts -> Generate New Private Key. Used to
# verify ID tokens the frontend sends after a user logs in with Firebase.
# Never commit this file.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Alternative to FIREBASE_SERVICE_ACCOUNT_PATH for hosts with no writable
# filesystem to drop a key file on - paste the *entire* service account JSON
# as one line here instead. If both are set, this one wins.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated extra origins CORS should allow, beyond localhost:5173/3000
# used in dev - set this to your deployed frontend's real origin(s).
ALLOWED_ORIGINS=
